# ============================================================
# YouTube KOL Workflow - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env file
# ============================================================

# ---- YouTube Data API (required) ----
# Get from Google Cloud Console > enable "YouTube Data API v3" > create API Key
YOUTUBE_API_KEY=your_youtube_api_key_here

# ---- Feishu / Lark Bitable Sync (optional) ----
# Auth mode: auto (default, lark-cli browser OAuth) / cli / app
#   - auto/cli: leave APP_ID/SECRET empty, lark-cli guides browser auth
#   - app: must fill APP_ID/SECRET/TOKEN below
FEISHU_AUTH_MODE=auto
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=

# Base name (used when creating a new Base)
FEISHU_BASE_NAME=KOL网红开发工作流

# lark-cli profile name
FEISHU_CLI_PROFILE=kol-workflow

# ---- Feishu Table IDs (fill after creating Base via sync_to_user_base.py) ----
# Get from Feishu Base URL or: lark-cli base +table-list --base-token <TOKEN>
# 每个目标 Base 一个 token；未用到的可留空
FEISHU_BASE_TOKEN=your_base_token_here        # 主库 VyH0 网红详情表所在 Base
FEISHU_BASE_TOKEN_CFC1=your_cfc1_base_token   # CFC1 独立 Base（AirTag 护照包线，可选）
FEISHU_TBL_INFLUENCERS=
FEISHU_TBL_VIDEOS=
FEISHU_TBL_CHANNEL_VIDEOS=
FEISHU_TBL_SEARCH_TASKS=
FEISHU_TBL_HONGREN=

# ---- Optional: Excel input path (defaults to output/kol_summary_tables.xlsx) ----
# KOL_XLSX=/path/to/your/kol_summary_tables.xlsx

# ---- Optional: Proxy for YouTube API (if in restricted regions) ----
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# ---- Optional: Search defaults ----
# REGION=US
# LANG_CODE=en
# LOG_LEVEL=INFO
# OUTPUT_DIR=output
